        {
            "type": "text",
            "bbox": [
                0.21,
                0.627,
                0.54,
                0.648
            ],
            "angle": 0,
            "content": "（一）在入股禁止期内入股；",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.21,
                0.66,
                0.648,
                0.681
            ],
            "angle": 0,
            "content": "（二）利用原职务影响谋取投资机会；",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.21,
                0.693,
                0.781,
                0.715
            ],
            "angle": 0,
            "content": "（三）入股过程存在价格不公允等利益输送情形；",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.21,
                0.726,
                0.512,
                0.747
            ],
            "angle": 0,
            "content": "（四）通过代持方式入股；",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.21,
                0.759,
                0.565,
                0.781
            ],
            "angle": 0,
            "content": "（五）入股资金来源违法违规；",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.21,
                0.793,
                0.512,
                0.814
            ],
            "angle": 0,
            "content": "（六）其他不当入股情形。",
            "merge_prev": false
        },
