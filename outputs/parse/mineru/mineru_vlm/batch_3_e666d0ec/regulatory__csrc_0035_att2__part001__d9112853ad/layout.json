                                        446,
                                        250
                                    ],
                                    "type": "text",
                                    "content": "（三）完善董事、董事会及专门委员会的要求"
                                }
                            ]
                        }
                    ],
                    "index": 1,
                    "level": 2
                },
                {
                    "bbox": [
                        86,
                        259,
                        512,
