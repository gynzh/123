                                        500,
                                        315,
                                        518
                                    ],
                                    "type": "text",
                                    "content": "（一）完善股东会运作机制"
                                }
                            ]
                        }
                    ],
                    "index": 5,
                    "level": 2
                },
                {
                    "bbox": [
                        86,
                        529,
                        512,
                        729
                    ],
                    "type": "text",
                    "angle": 0,
                    "lines": [
                        {
                            "bbox": [
