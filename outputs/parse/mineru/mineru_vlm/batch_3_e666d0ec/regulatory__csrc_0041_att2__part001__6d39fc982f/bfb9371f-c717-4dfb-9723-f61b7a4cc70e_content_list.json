        "table_caption": [
            "表 A.2 证券期货业机构实时信息系统备份能力分级"
        ],
        "table_footnote": [],
        "table_body": "<table><tr><td>级别</td><td>故障应对能力</td><td>灾难应对能力</td><td>重大灾难应对能力</td></tr><tr><td>第一级</td><td> $\\mathrm{RTO} \\leqslant 4$ 小时; $\\mathrm{RPO} \\leqslant 5$ 分钟;容量应满足业务要求。</td><td> $\\mathrm{RTO} \\leqslant 24$ 小时; $\\mathrm{RPO} \\leqslant 5$ 分钟;容量应满足业务要求。</td><td> $\\mathrm{RTO} \\leqslant 7$ 天; $\\mathrm{RPO} \\leqslant 24$ 小时;容量应满足业务要求。</td></tr><tr><td>第二级</td><td> $\\text{RTO} \\leq 2 \\text{小时};$  $\\text{RPO} \\leq 5 \\text{分钟};$ 容量应满足业务要求。</td><td> $\\text{RTO} \\leq 12 \\text{小时};$  $\\text{RPO} \\leq 5 \\text{分钟};$ 容量应满足业务要求。</td><td> $\\text{RTO} \\leq 3 \\text{天};$  $\\text{RPO} \\leq 24 \\text{小时};$ 容量应满足业务要求。</td></tr><tr><td>第三级</td><td> $\\text{RTO} \\leq 1 \\text{小时};$  $\\text{RPO} \\leq 5 \\text{分钟};$ 容量应满足业务要求。</td><td> $\\text{RTO} \\leq 2 \\text{小时};$  $\\text{RPO} \\leq 5 \\text{分钟};$ 容量应满足业务要求。</td><td> $\\text{RTO} \\leq 1 \\text{天};$  $\\text{RPO} \\leq 12 \\text{小时};$ 容量应满足业务要求。</td></tr><tr><td>第四级</td><td> $\\text{RTO} \\leq 30 \\text{分钟};$  $\\text{RPO} \\leq 1 \\text{分钟};$ 容量应满足业务要求。</td><td> $\\text{RTO} \\leq 1 \\text{小时};$  $\\text{RPO} \\leq 1 \\text{分钟};$ 容量应满足业务要求。</td><td> $\\text{RTO} \\leq 4 \\text{小时};$  $\\text{RPO} \\leq 30 \\text{分钟};$ 容量应满足业务要求。</td></tr><tr><td>第五级</td><td> $\\text{RTO} \\leq 5 \\text{分钟};$  $\\text{RPO} \\leq 30 \\text{秒};$ 容量应满足业务要求。</td><td> $\\text{RTO} \\leq 10 \\text{分钟};$  $\\text{RPO} \\leq 30 \\text{秒};$ 容量应满足业务要求。</td><td> $\\text{RTO} \\leq 2 \\text{小时};$  $\\text{RPO} \\leq 15 \\text{分钟};$ 容量应满足业务要求。</td></tr><tr><td>第六级</td><td> $\\text{RTO} \\leq 1 \\text{分钟};$  $\\text{RPO} \\leq 1 \\text{秒};$ 容量应满足业务要求。</td><td> $\\text{RTO} \\leq 3 \\text{分钟};$  $\\text{RPO} \\leq 10 \\text{秒};$ 容量应满足业务要求。</td><td> $\\text{RTO} \\leq 30 \\text{分钟};$  $\\text{RPO} \\leq 5 \\text{分钟};$ 容量应满足业务要求。</td></tr></table>",
