    [
        {
            "type": "text",
            "bbox": [
                0.146,
                0.096,
                0.859,
                0.194
            ],
            "angle": 0,
            "content": "证券登记结算机构应当对本基金的计收、管理、使用情况进行记录和保存，并在每一财政年度终了后六个月内，向中国证监会、财政部报送年度情况报告。",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.199,
                0.203,
                0.773,
                0.228
            ],
            "angle": 0,
            "content": "第十六条 本办法由中国证监会会同财政部解释。",
            "merge_prev": false
        },
        {
            "type": "text",
            "bbox": [
                0.146,
                0.238,
                0.855,
                0.336
            ],
            "angle": 0,
            "content": "第十七条 本办法自2025年12月8日起施行。2006年6月16日中国证监会、财政部发布的《证券结算风险基金管理办法》（证监发〔2006〕65号）同时废止。",
            "merge_prev": false
        },
