                            ],
                            "spans": [
                                {
                                    "bbox": [
                                        86,
                                        80,
                                        511,
                                        225
                                    ],
                                    "type": "text",
                                    "content": "《指引》相关要求比照适用于《高管办法》第五十六条规定的机构及其相关人员。《指引》发布后，证券基金经营机构和《高管办法》第五十六条规定的机构应当及时将《指引》相关要求告知公司主要股东，提醒主要股东严格按照要求提名符合条件的董事、监事和高级管理人员。",
                                    "cross_page": true
                                }
