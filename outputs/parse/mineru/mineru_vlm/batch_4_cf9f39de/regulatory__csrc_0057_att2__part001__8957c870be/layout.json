                                        293
                                    ],
                                    "type": "text",
                                    "content": "一、修订背景"
                                }
                            ]
                        }
                    ],
                    "index": 2,
                    "level": 2
                },
                {
                    "bbox": [
                        86,
                        302,
                        508,
