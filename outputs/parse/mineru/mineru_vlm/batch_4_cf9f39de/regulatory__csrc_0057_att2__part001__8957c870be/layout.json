                            "spans": [
                                {
                                    "bbox": [
                                        86,
                                        666,
                                        508,
                                        742
                                    ],
                                    "type": "text",
                                    "content": "主要修订内容包括：一是进一步明确派出机构辅导监管职责。派出机构除对辅导工作成效等开展验收外，还应加强监管理念和政策的传导。二是回应市场关切，增强制度灵活"
                                }
                            ]
                        }
                    ],
