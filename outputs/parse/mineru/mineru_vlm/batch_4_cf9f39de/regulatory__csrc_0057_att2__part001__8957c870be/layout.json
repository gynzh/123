                                    "bbox": [
                                        119,
                                        498,
                                        219,
                                        516
                                    ],
                                    "type": "text",
                                    "content": "二、修订内容"
                                }
                            ]
                        }
                    ],
                    "index": 4,
                    "level": 2
                },
                {
                    "bbox": [
                        86,
                        526,
